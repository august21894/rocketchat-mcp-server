# Precedence: SYSTEM environment variables always win over this file. Values
# here are only a fallback for keys not already set in the environment. The file
# location is <cwd>/.env by default, or the path in ROCKETCHAT_ENV_FILE.

# ---------------------------------------------------------------------------
# Rocket.Chat connection (required)
# ---------------------------------------------------------------------------
# Base URL of the Rocket.Chat workspace. HTTPS is required except for localhost.
ROCKETCHAT_BASE_URL=https://chat.example.com
# Bot account user id (the "X-User-Id" header value).
ROCKETCHAT_USER_ID=bot-user-id
# Personal Access Token for the bot account (the "X-Auth-Token" header value).
# NEVER commit a real token. Load it from a secret manager in production.
ROCKETCHAT_AUTH_TOKEN=replace-with-personal-access-token
# Optional human-readable workspace name used in MCP titles/descriptions so
# agents can route phrases such as "send to Facon". Defaults to the URL hostname.
ROCKETCHAT_WORKSPACE_NAME=

# ---------------------------------------------------------------------------
# Destination policy
# ---------------------------------------------------------------------------
# Comma separated list of allowed room names and/or room ids. EMPTY means
# ALLOW-ANY joined room; a non-empty list restricts to exactly those rooms.
# Whitespace around entries is trimmed.
ROCKETCHAT_ALLOWED_ROOMS=
# Master switch for direct messages. When false, no DM can be sent.
ROCKETCHAT_ALLOW_DM=true
# Comma separated list of usernames allowed as DM recipients.
# When ROCKETCHAT_ALLOW_DM=true: EMPTY means ANY recipient is allowed; a
# non-empty list restricts DMs to exactly those usernames.
ROCKETCHAT_ALLOWED_DM_USERS=

# ---------------------------------------------------------------------------
# Mention policy
# ---------------------------------------------------------------------------
ROCKETCHAT_ALLOW_HERE_MENTION=true
ROCKETCHAT_ALLOW_ALL_MENTION=true

# ---------------------------------------------------------------------------
# Content policy
# ---------------------------------------------------------------------------
ROCKETCHAT_MAX_TEXT_LENGTH=10000
ROCKETCHAT_REQUEST_TIMEOUT_MS=10000
ROCKETCHAT_DISABLE_URL_PREVIEW=true

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Only "stdio" is supported in the MVP.
MCP_TRANSPORT=stdio
# One of: debug | info | warn | error
LOG_LEVEL=info
